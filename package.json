{
  "name": "dindin",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @dindin/db db:generate",
    "db:migrate": "pnpm --filter @dindin/db db:migrate"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "latest"
  }
}
